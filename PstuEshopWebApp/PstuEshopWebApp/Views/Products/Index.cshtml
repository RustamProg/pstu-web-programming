@using PstuEshopWebApp.Constants

@model CatalogViewModel
@{
    ViewData["Title"] = "Каталог товаров";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<h1 class="mb-4">Каталог товаров</h1>

<p>
    Корзина:
    <span id="cart-count" class="badge bg-primary">0</span>
    товаров
</p>

<input type="hidden"
       id="cart-antiforgery-token"
       value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

@if (Model.SelectedCityCode is not null)
{
    <p>
        Ваш город:
        <strong>
            @CityOptions.Names[Model.SelectedCityCode]
        </strong>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                data-bs-toggle="modal"
                data-bs-target="#cityModal"> @*Открываем эту модалку, она ниже*@
            Изменить
        </button>
    </p>
}

<div class="modal fade" id="cityModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-controller="City"
                  asp-action="Select"
                  method="post">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Выберите город
                    </h5>
                </div>

                <div class="modal-body">
                    <select name="city"
                            class="form-select"
                            required>
                        <option value="" selected disabled>
                            Выберите город
                        </option>

                        @foreach (var city in CityOptions.Names)
                        {
                            <option value="@city.Key">
                                @city.Value
                            </option>
                        }
                    </select>

                    <input type="hidden"
                           name="returnUrl"
                           value="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" />
                </div>

                <div class="modal-footer">
                    <button type="submit" @*Не писали javascript ajax запрос, поэтому по умолчанию приводит к перезагрузке страницы*@
                            class="btn btn-primary">
                        Сохранить
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<form id="catalog-filters"
      asp-controller="Products"
      asp-action="Index"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-5">
        <label asp-for="Category" class="form-label">
            Категория
        </label>

        <select asp-for="Category" @*Делает из значения query-parameter*@
                asp-items="@(new SelectList(Model.Categories))"
                class="form-select">
            <option value="">Все категории</option>
        </select>
    </div>

    <div class="col-md-5">
        <label asp-for="Sort" class="form-label">
            Сортировка
        </label>

        <select asp-for="Sort" class="form-select">
            <option value="name_asc">По названию (A-Z)</option>
            <option value="name_desc">По названию (Z-A)</option>
            <option value="price_asc">Сначала дешёвые</option>
            <option value="price_desc">Сначала дорогие</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100"> @*В catalog.js подписываемся на submit этой формы*@
            Применить
        </button>
    </div>
</form>

<div id="product-list">
    <partial name="_ProductCards" model="Model.Products" /> @*При первом заходе на страницу отображаем товары отсюда, затем уже ajax запросами заменяется фрагмент html*@
</div>


@section Scripts {
    @*
    Без этого скрипта, тоже будет работать, 
    но submit будет просто перезагружать текущую страницу с применением фильтров.
    Все будет работать, но будем видеть полную перезагрузку страницы, а не просто изменение списка
    *@
    <script src="~/js/catalog.js" asp-append-version="true"></script>

    <script src="~/js/cart.js" asp-append-version="true"></script>

    @if (Model.SelectedCityCode is null) @*Если город не выбран, то по умолчанию показываем окно выбора*@
    {
        <script>
            const cityModal = new bootstrap.Modal(
                document.getElementById("cityModal"),
                {
                    backdrop: "static", @*Нельзя закрыть нажатием на фон*@
                    keyboard: false @*Нельзя закрыть нажатием на esc*@
                }
            );

            cityModal.show();
        </script>
    }
}